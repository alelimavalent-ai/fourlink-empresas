---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import { RH } from '@/config/site';

const path = '/trabalhe-conosco';
const rhWa = `https://wa.me/${RH.whatsappDigits}?text=${encodeURIComponent(RH.message)}`;
const breadcrumbs = [
  { name: 'Início', href: '/' },
  { name: 'Trabalhe conosco', href: path },
];
const valores = [
  { t: 'Atendimento que resolve', d: 'Aqui a gente não empurra o cliente para uma central. A gente resolve. Se você gosta de resolver, vai se sentir em casa.' },
  { t: 'Crescimento de verdade', d: 'Temos programa de jovem aprendiz e trilhas para quem quer evoluir no comercial, no atendimento e na parte técnica.' },
  { t: 'Time de gente boa', d: 'Um ambiente próximo, com liderança presente e espaço para quem tem vontade de fazer acontecer.' },
];
---

<BaseLayout
  title="Trabalhe conosco | Fourlink Empresas"
  description="Faça parte da Fourlink Empresas. Deixe seu currículo com a Alessandra RH e entre para um time que resolve. Respondemos em até 24 horas."
  path={path}
  breadcrumbs={breadcrumbs}
>
  <header class="tc-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Início</a><span>/</span><b>Trabalhe conosco</b>
      </nav>
      <span class="eyebrow dk">Trabalhe conosco</span>
      <h1>Venha fazer parte da Fourlink</h1>
      <p class="intro">
        Ser Fourlink é ter orgulho de resolver. Buscamos gente que gosta de atender bem, aprender rápido
        e crescer junto. Se é você, queremos te conhecer.
      </p>
      <a href={rhWa} class="cta-rh" target="_blank" rel="noopener" aria-label="Falar com a Alessandra RH no WhatsApp">
        <svg class="wa-ic" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.334.101 11.892c0 2.096.549 4.142 1.595 5.945L0 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.585 0 11.946-5.336 11.949-11.896 0-3.176-1.24-6.165-3.495-8.411"/></svg>
        <span>Falar com a Alessandra RH</span>
      </a>
    </div>
  </header>

  <section class="tc-sec">
    <div class="container">
      <h2 class="mh">Por que trabalhar na Fourlink</h2>
      <ul class="tc-grid">
        {valores.map((v) => (
          <li>
            <strong>{v.t}</strong>
            <span>{v.d}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="tc-sec mist">
    <div class="container">
      <div class="tc-apply">
        <div class="tc-apply-text">
          <span class="eyebrow">Como se candidatar</span>
          <h2>Deixe seu currículo com a Alessandra RH</h2>
          <p>
            É simples e rápido: envie seu currículo e um contato pelo WhatsApp da nossa área de RH.
            {' '}<strong>{RH.slaText}</strong>
          </p>
          <ol class="tc-steps">
            <li>Toque no botão abaixo para abrir a conversa com a <strong>{RH.name}</strong>.</li>
            <li>Envie seu currículo (PDF) e um contato para retorno.</li>
            <li>Pronto — nossa equipe responde em até 24 horas.</li>
          </ol>
        </div>
        <div class="tc-card">
          <span class="tc-label">Recursos Humanos</span>
          <strong class="tc-name">{RH.name}</strong>
          <span class="tc-num">WhatsApp: {RH.whatsappDisplay}</span>
          <a href={rhWa} class="cta-rh" target="_blank" rel="noopener">
            <svg class="wa-ic" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.334.101 11.892c0 2.096.549 4.142 1.595 5.945L0 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.585 0 11.946-5.336 11.949-11.896 0-3.176-1.24-6.165-3.495-8.411"/></svg>
            <span>Enviar currículo agora</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .tc-hero { background: var(--grad-soft); color: #fff; padding-block: clamp(2.6rem, 7vw, 4.5rem); }
  .crumbs { font-size: 0.8rem; color: #9fb0d2; display: flex; gap: 0.45rem; align-items: center; margin-bottom: 1.4rem; }
  .crumbs a:hover { color: #fff; } .crumbs b { color: #fff; font-weight: 500; }
  .eyebrow.dk { color: var(--copper-soft); }
  .tc-hero h1 { color: #fff; font-size: var(--step-3); margin: 0.7rem 0 1rem; }
  .intro { color: #c6d1ea; max-width: 60ch; font-size: var(--step-1); line-height: 1.55; margin-bottom: 1.6rem; }

  .cta-rh {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem;
    background: #25d366; color: #fff; font-family: var(--font-display); font-weight: 600;
    font-size: 0.98rem; padding: 0.85rem 1.4rem; border-radius: 999px; text-decoration: none;
    box-shadow: 0 10px 26px -8px rgba(37,211,102,.5);
    transition: transform 0.18s ease, background 0.18s ease;
  }
  .cta-rh:hover { background: #1fbe5b; transform: translateY(-2px); }
  .cta-rh .wa-ic { width: 21px; height: 21px; flex-shrink: 0; }

  .tc-sec { padding-block: clamp(3rem, 7vw, 5rem); }
  .mh { font-size: var(--step-2); color: var(--navy); margin-bottom: 1.6rem; }
  .tc-grid { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.1rem; }
  .tc-grid li { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.5rem; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); }
  .tc-grid strong { color: var(--navy); font-family: var(--font-display); font-size: 1.1rem; }
  .tc-grid span { color: var(--muted); line-height: 1.6; }

  .tc-apply { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(1.6rem, 4vw, 3rem); align-items: center; }
  .tc-apply h2 { font-size: var(--step-2); color: var(--navy); margin: 0.6rem 0 0.9rem; }
  .tc-apply-text p { color: #2c3650; line-height: 1.7; margin-bottom: 1.1rem; }
  .tc-steps { margin: 0; padding-left: 1.2rem; display: flex; flex-direction: column; gap: 0.6rem; color: #2c3650; line-height: 1.6; }
  .tc-card { background: var(--grad-soft); color: #fff; border-radius: var(--radius-lg); padding: 1.8rem; box-shadow: var(--shadow-md); border: 1px solid rgba(216,168,120,.35); text-align: center; }
  .tc-label { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--copper-soft); }
  .tc-name { display: block; font-family: var(--font-display); font-size: 1.4rem; margin: 0.5rem 0 0.3rem; }
  .tc-num { display: block; font-family: var(--font-mono); font-size: 0.85rem; color: #c6d1ea; margin-bottom: 1.3rem; }
  @media (max-width: 800px) { .tc-apply { grid-template-columns: 1fr; } }
</style>
