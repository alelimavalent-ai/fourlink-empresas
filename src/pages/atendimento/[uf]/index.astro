---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const ufNomes: Record<string, string> = { rj: 'Rio de Janeiro', mg: 'Minas Gerais', es: 'Espírito Santo' };
  return (['rj', 'mg', 'es'] as const).map((uf) => ({ params: { uf }, props: { uf, ufNome: ufNomes[uf] } }));
}

const { uf, ufNome } = Astro.props;
const cidades = (await getCollection('cidades'))
  .filter((c) => c.data.uf === uf)
  .sort((a, b) => a.data.cidade.localeCompare(b.data.cidade));

const breadcrumbs = [
  { name: 'Início', href: '/' },
  { name: 'Atendimento', href: '/atendimento' },
  { name: ufNome, href: `/atendimento/${uf}` },
];
---

<BaseLayout
  title={`Telefonia Corporativa em ${ufNome} | Fourlink Empresas`}
  description={`Fourlink Empresas em ${ufNome}: chip corporativo, internet fibra empresarial, portabilidade e redução de custos de telefonia para empresas. Atendimento 24h.`}
  path={`/atendimento/${uf}`}
  breadcrumbs={breadcrumbs}
>
  <header class="hub-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Início</a><span>/</span><a href="/atendimento">Atendimento</a><span>/</span><b>{ufNome}</b>
      </nav>
      <h1>Fourlink Empresas em {ufNome}</h1>
      <p>Telefonia corporativa e internet empresarial para empresas de {ufNome}, com análise de fatura e atendimento 24h.</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <h2 class="mh">Cidades atendidas em {ufNome}</h2>
      {cidades.length > 0 ? (
        <ul class="city-list">
          {cidades.map((c) => <li><a href={`/atendimento/${uf}/${c.data.customSlug}`}>{c.data.cidade}</a></li>)}
        </ul>
      ) : (
        <p class="soon">Estamos publicando as páginas das cidades de {ufNome}. Fale com a Alessandra para atendimento imediato.</p>
      )}
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .hub-hero { background: var(--grad-soft); color: #fff; padding-block: clamp(2.5rem, 7vw, 4.5rem); }
  .crumbs { font-size: 0.8rem; color: #9fb0d2; display: flex; gap: 0.45rem; align-items: center; margin-bottom: 1.4rem; flex-wrap: wrap; }
  .crumbs a:hover { color: #fff; }
  .crumbs b { color: #fff; font-weight: 500; }
  .hub-hero h1 { color: #fff; font-size: var(--step-3); margin-bottom: 0.8rem; }
  .hub-hero p { color: #c6d1ea; max-width: 56ch; font-size: var(--step-1); }
  .mh { font-size: var(--step-2); margin-bottom: 1.4rem; }
  .city-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.6rem; }
  .city-list a {
    display: block; padding: 0.8rem 1rem; background: #fff; border: 1px solid var(--line);
    border-radius: var(--radius); font-weight: 500; color: var(--navy);
    transition: border-color 0.18s, color 0.18s, transform 0.18s;
  }
  .city-list a:hover { border-color: var(--pink); color: var(--pink); transform: translateX(3px); }
  .soon { color: var(--muted); }
</style>
