---
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 26, class: klass = '' } = Astro.props;
const p = {
  chip: '<rect x="6" y="6" width="12" height="12" rx="2.5"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/>',
  fiber: '<path d="M3 12c4-6 14-6 18 0M6 12c2.6-3.6 9.4-3.6 12 0M9 12c1.2-1.6 4.8-1.6 6 0"/><circle cx="12" cy="17" r="1.6"/>',
  port: '<path d="M4 8h11M4 8l3-3M4 8l3 3M20 16H9M20 16l-3-3M20 16l-3 3"/>',
  manage: '<rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="18" height="6" rx="1.5"/><circle cx="7" cy="7" r="1"/><circle cx="7" cy="17" r="1"/>',
  consult: '<path d="M12 3a9 9 0 0 0-9 9 9 9 0 0 0 4.5 7.8L7 22l3.2-1.4A9 9 0 1 0 12 3Z"/><path d="M9 11h6M9 14h4"/>',
  savings: '<path d="M3 12a8 7 0 0 1 16 0v3a2 2 0 0 1-2 2h-1l-1 2H8l-1-2H5a2 2 0 0 1-2-2Z"/><circle cx="9" cy="11" r="1"/><path d="M19 9a2 2 0 0 1 2 2"/>',
}[name] ?? '<circle cx="12" cy="12" r="8"/>';
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={klass}
  aria-hidden="true"
  set:html={p}
/>
