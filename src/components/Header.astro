---
import BrandMark from '@/components/BrandMark.astro';
import { NAV } from '@/config/site';
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="hdr">
  <div class="container hdr-inner">
    <a href="/" class="brand" aria-label="Fourlink Empresas — página inicial">
      <BrandMark size={34} />
      <span class="wordmark">Four<span class="lk">link</span> <em>Empresas</em></span>
    </a>

    <nav class="nav" aria-label="Navegação principal">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hdr-actions">
      <a href="/calculadora-de-economia" class="btn btn-primary hdr-cta">
        Calcular economia
      </a>
      <button class="burger" aria-label="Abrir menu" aria-expanded="false" aria-controls="m-menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="m-menu" id="m-menu" hidden>
    <ul>
      {NAV.map((item) => <li><a href={item.href} class:list={['m-link', { active: isActive(item.href) }]}>{item.label}</a></li>)}
    </ul>
    <a href="/calculadora-de-economia" class="btn btn-primary">Calcular economia</a>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .hdr-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 70px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.32rem;
    letter-spacing: -0.03em;
    color: var(--navy);
  }
  .wordmark .lk {
    color: var(--blue);
  }
  .wordmark em {
    font-style: normal;
    font-weight: 500;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-transform: uppercase;
  }
  .nav ul {
    display: flex;
    gap: 0.3rem;
  }
  .nav-link {
    font-size: 0.93rem;
    font-weight: 500;
    color: var(--ink);
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    transition: color 0.15s, background 0.15s;
  }
  .nav-link:hover {
    color: var(--navy);
    background: var(--mist);
  }
  .nav-link.active {
    color: var(--pink);
  }
  .hdr-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .hdr-cta {
    padding: 0.6rem 1.05rem;
    font-size: 0.9rem;
  }
  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    padding: 0.4rem;
    cursor: pointer;
  }
  .burger span {
    width: 24px;
    height: 2px;
    background: var(--navy);
    border-radius: 2px;
    transition: transform 0.25s, opacity 0.2s;
  }
  .burger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .burger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .burger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  .m-menu {
    border-top: 1px solid var(--line);
    padding: 1rem var(--gutter) 1.6rem;
    background: #fff;
  }
  .m-menu ul {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-bottom: 1rem;
  }
  .m-link {
    display: block;
    padding: 0.75rem 0.6rem;
    font-weight: 500;
    border-radius: 8px;
    border-bottom: 1px solid var(--mist-2);
  }
  .m-link.active {
    color: var(--pink);
  }
  .m-menu .btn {
    width: 100%;
  }

  @media (max-width: 940px) {
    .nav,
    .hdr-cta {
      display: none;
    }
    .burger {
      display: flex;
    }
  }
  @media (min-width: 941px) {
    .m-menu {
      display: none !important;
    }
  }
</style>

<script>
  const burger = document.querySelector('.burger');
  const menu = document.getElementById('m-menu');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
</script>
