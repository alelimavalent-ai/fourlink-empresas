---
import { TEAM } from '@/config/site';
interface Props {
  heading?: string;
  intro?: string;
}
const {
  heading = 'Gente de verdade cuidando da sua empresa',
  intro = 'Especialistas experientes e um programa de formação de novos talentos. É essa equipe que analisa a sua fatura e acompanha as suas linhas no dia a dia.',
} = Astro.props;
---

<section class="team section">
  <div class="container">
    <span class="eyebrow">Equipe Fourlink</span>
    <h2>{heading}</h2>
    <p class="lead team-intro">{intro}</p>

    <div class="team-grid">
      {
        TEAM.map((m) => (
          <article class="tcard">
            <figure>
              <img
                src={`/img/${m.img}-800.webp`}
                srcset={`/img/${m.img}-480.webp 480w, /img/${m.img}-800.webp 800w`}
                sizes="(max-width: 560px) 50vw, 260px"
                width="800"
                height="1000"
                alt={`${m.name}, ${m.role} da Fourlink Empresas`}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="tinfo">
              <strong>{m.name}</strong>
              <span class="trole">{m.role}</span>
              <span class="ttag mono">{m.tag}</span>
              <p class="tnote">{m.note}</p>
            </div>
          </article>
        ))
      }
    </div>

    <figure class="salao">
      <img
        src="/img/salao-atendimento-1080.webp"
        srcset="/img/salao-atendimento-720.webp 720w, /img/salao-atendimento-1080.webp 1080w"
        sizes="(max-width: 1120px) 100vw, 1080px"
        width="1080"
        height="787"
        alt="Salão de atendimento da Fourlink Empresas, no Rio de Janeiro"
        loading="lazy"
        decoding="async"
      />
      <figcaption>Nosso salão de atendimento — Rio de Janeiro</figcaption>
    </figure>
  </div>
</section>

<style>
  .team { background: var(--mist); }
  .team h2 { font-size: var(--step-2); margin: 0.6rem 0 0.8rem; max-width: 20ch; }
  .team-intro { max-width: 60ch; margin-bottom: 2.4rem; }
  .team-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(196px, 1fr)); gap: clamp(1rem, 2.5vw, 1.4rem); }
  .tcard {
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg);
    overflow: hidden; box-shadow: var(--shadow-sm); transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .tcard:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .tcard figure { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; background: var(--mist-2); }
  .tcard figure img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tinfo { padding: 1.1rem 1.2rem 1.4rem; }
  .tinfo strong { color: var(--navy); display: block; font-size: 1.05rem; font-family: var(--font-display); }
  .trole { color: var(--pink); font-weight: 600; font-size: 0.8rem; display: block; margin-top: 0.1rem; }
  .ttag {
    display: inline-block; margin-top: 0.55rem; font-size: 0.66rem; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--navy); background: var(--mist-2);
    border: 1px solid var(--line); border-radius: 99px; padding: 0.28rem 0.66rem;
  }
  .tnote { font-size: 0.84rem; color: var(--muted); margin-top: 0.65rem; line-height: 1.5; }
  .salao {
    margin: clamp(1.6rem, 4vw, 2.4rem) 0 0; border-radius: var(--radius-lg); overflow: hidden;
    border: 1px solid var(--line); box-shadow: var(--shadow-md); background: #fff;
  }
  .salao img { width: 100%; height: auto; display: block; }
  .salao figcaption {
    font-family: var(--font-mono); font-size: 0.76rem; color: var(--muted);
    padding: 0.8rem 1.1rem; background: #fff; border-top: 1px solid var(--line);
  }
  @media (max-width: 880px) { .team-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 420px) { .team-grid { grid-template-columns: 1fr; } }
</style>
