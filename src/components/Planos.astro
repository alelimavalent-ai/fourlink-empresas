---
import { PLANS_CHIPS, CHIPS_FEATURES, PLANS_FIBRA, whatsappUrl } from '@/config/site';
interface Props {
  tipo: 'chips' | 'fibra';
}
const { tipo } = Astro.props;
---

{
  tipo === 'chips' && (
    <section class="planos">
      <div class="container">
        <div class="planos-head">
          <span class="eyebrow">Planos · Chip Empresarial</span>
          <h2>Escolha o plano ideal para a sua empresa</h2>
          <p class="lead">Todos os planos incluem ligações ilimitadas, WhatsApp e redes sociais ilimitados, sem taxas e sem fidelidade — para CNPJ e MEI.</p>
        </div>

        <div class="plan-grid">
          {PLANS_CHIPS.map((p) => (
            <div class:list={['plan-card', { pop: 'popular' in p && p.popular }]}>
              {'popular' in p && p.popular && <span class="badge">Mais escolhido</span>}
              <span class="plan-gb mono">{p.gb}</span>
              <span class="plan-bonus">{p.bonus}</span>
              <div class="plan-price">
                <span class="cur">R$</span>
                <span class="val mono" data-count={p.price}>{p.price}</span>
                <span class="per">/mês</span>
              </div>
              <a href={whatsappUrl(`Tenho interesse no plano ${p.gb} (R$ ${p.price}/mês).`)} class="btn btn-primary btn-sm" target="_blank" rel="noopener">
                Quero este plano
              </a>
            </div>
          ))}
        </div>

        <ul class="plan-feats">
          {CHIPS_FEATURES.map((f) => (
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12l4 4 10-11" /></svg>
              {f}
            </li>
          ))}
        </ul>
        <p class="plan-note">Valores e condições podem variar conforme a análise do perfil da empresa.</p>
      </div>
    </section>
  )
}

{
  tipo === 'fibra' && (
    <section class="planos">
      <div class="container">
        <div class="planos-head">
          <span class="eyebrow">Planos · Internet Fibra</span>
          <h2>Fibra empresarial para operações que não param</h2>
          <p class="lead">Conexão estável e dedicada ao seu negócio, com instalação rápida e suporte especializado.</p>
        </div>
        <div class="fibra-grid">
          {PLANS_FIBRA.map((p) => (
            <div class:list={['fibra-card', { pop: 'popular' in p && p.popular }]}>
              {'popular' in p && p.popular && <span class="badge">Alta performance</span>}
              <h3>{p.nome}</h3>
              <p class="fibra-spec mono">{p.download}</p>
              <p class="fibra-spec up mono">{p.upload}</p>
              <div class="plan-price">
                <span class="cur">R$</span>
                <span class="val mono" data-count={p.price}>{p.price}</span>
                <span class="per">/mês</span>
              </div>
              <p class="fibra-dest">{p.destaque}</p>
              <a href={whatsappUrl(`Tenho interesse na fibra ${p.nome} (R$ ${p.price}/mês).`)} class="btn btn-primary btn-sm" target="_blank" rel="noopener">
                Quero esta fibra
              </a>
            </div>
          ))}
        </div>
        <p class="plan-note">Valores e condições podem variar conforme análise de viabilidade e perfil da empresa.</p>
      </div>
    </section>
  )
}

<script>
  (() => {
    const fmt = (n) => n.toFixed(2).replace('.', ',');
    const animate = (el) => {
      const target = parseFloat((el.dataset.count || '').replace(',', '.'));
      if (isNaN(target)) return;
      const dur = 900;
      const start = performance.now();
      const tick = (now) => {
        const t = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = fmt(target * eased);
        if (t < 1) requestAnimationFrame(tick);
        else el.textContent = el.dataset.count;
      };
      requestAnimationFrame(tick);
    };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const els = document.querySelectorAll('.planos [data-count]');
    if (reduce || !('IntersectionObserver' in window)) return;
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { animate(e.target); obs.unobserve(e.target); }
      });
    }, { threshold: 0.6 });
    els.forEach((el) => { el.textContent = '0,00'; obs.observe(el); });
  })();
</script>

<style>
  .planos {
    padding-block: clamp(3rem, 7vw, 5rem);
    background: var(--mist);
  }
  .planos-head {
    max-width: 640px;
    margin-bottom: 2.6rem;
  }
  .planos-head h2 {
    font-size: var(--step-2);
    margin: 0.6rem 0 0.7rem;
  }
  .plan-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }
  .plan-card {
    position: relative;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.3rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .plan-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .plan-card.pop {
    border-color: var(--pink);
    box-shadow: 0 10px 30px rgba(200, 49, 26, 0.16);
  }
  .badge {
    position: absolute;
    top: -11px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--pink);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.25rem 0.7rem;
    border-radius: 99px;
    white-space: nowrap;
  }
  .plan-gb {
    font-size: 1.9rem;
    font-weight: 500;
    color: var(--navy);
    line-height: 1;
  }
  .plan-bonus {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .plan-price {
    display: flex;
    align-items: baseline;
    gap: 0.15rem;
    margin: 0.6rem 0 1rem;
    color: var(--ink);
  }
  .plan-price .cur {
    font-size: 0.9rem;
    color: var(--muted);
  }
  .plan-price .val {
    font-size: 1.7rem;
    font-weight: 500;
  }
  .plan-price .per {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .btn-sm {
    padding: 0.6rem 1rem;
    font-size: 0.85rem;
    width: 100%;
  }
  .plan-feats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.6rem;
    margin-top: 1.8rem;
    justify-content: center;
  }
  .plan-feats li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--navy);
    font-weight: 500;
  }
  .plan-feats svg {
    color: var(--pink);
  }
  .plan-note {
    text-align: center;
    font-size: 0.78rem;
    color: var(--muted);
    margin-top: 1.2rem;
  }
  .fibra-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.2rem;
    max-width: 760px;
  }
  .fibra-card {
    position: relative;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.8rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .fibra-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .fibra-card.pop {
    border-color: var(--pink);
  }
  .fibra-card h3 {
    font-size: 1.4rem;
    color: var(--navy);
    margin-bottom: 0.6rem;
  }
  .fibra-spec {
    font-size: 0.88rem;
    color: var(--ink);
  }
  .fibra-spec.up {
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .fibra-dest {
    font-size: 0.85rem;
    color: var(--pink);
    font-weight: 500;
    margin-bottom: 1.2rem;
  }
</style>

<script>
  // Anima os valores dos planos (chips e fibra) com contagem crescente ao entrar na tela.
  const parseBR = (s) => parseFloat(String(s).replace('.', '').replace(',', '.'));
  const fmtBR = (n) => n.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

  const animatePrice = (el) => {
    const target = parseBR(el.dataset.val || el.textContent);
    if (!isFinite(target)) return;
    const dur = 900;
    const start = performance.now();
    const step = (now) => {
      const t = Math.min(1, (now - start) / dur);
      const eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
      el.textContent = fmtBR(target * eased);
      if (t < 1) requestAnimationFrame(step);
      else el.textContent = fmtBR(target);
    };
    requestAnimationFrame(step);
  };

  document.querySelectorAll('.planos').forEach((sec) => {
    const vals = [...sec.querySelectorAll('.val')];
    vals.forEach((el) => { el.dataset.val = el.textContent.trim(); });
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return;
    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          vals.forEach((el, i) => setTimeout(() => animatePrice(el), i * 80));
          obs.disconnect();
        }
      });
    }, { threshold: 0.3 });
    io.observe(sec);
  });
</script>
