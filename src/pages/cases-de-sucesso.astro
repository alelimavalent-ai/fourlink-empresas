---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import { SITE, CASES } from '@/config/site';

const path = '/cases-de-sucesso';
const breadcrumbs = [
  { name: 'Início', href: '/' },
  { name: 'Cases de Sucesso', href: path },
];

// Case em destaque (primeiro da lista).
const caso = CASES[0];

const collectionSchema = {
  '@type': 'CollectionPage',
  '@id': `${SITE.domain}${path}#page`,
  name: 'Cases de Sucesso — Fourlink Empresas',
  description:
    'Empresas reais atendidas pela Fourlink Empresas que reduziram custos de telefonia corporativa e internet empresarial.',
  isPartOf: { '@id': `${SITE.domain}/#website` },
  about: { '@id': `${SITE.domain}/#organization` },
};
---

<BaseLayout
  title="Cases de Sucesso — Empresas atendidas pela Fourlink"
  description="Prova social real: empresas como a Comprec reduziram custos de telefonia corporativa com a Fourlink Empresas. Atendimento consultivo no RJ, MG e ES."
  path={path}
  breadcrumbs={breadcrumbs}
  schemas={[collectionSchema]}
>
  <header class="cases-hero">
    <div class="container">
      <span class="eyebrow on-dark">Cases de Sucesso · Prova Social</span>
      <h1>Resultados reais de empresas atendidas pela Fourlink</h1>
      <p>
        Por trás de cada economia existe uma empresa de verdade e um atendimento de gente. Conheça
        histórias reais de quem confiou na Fourlink Empresas para reduzir custos e organizar a operação.
      </p>
    </div>
  </header>

  <section class="section case" aria-labelledby="case-comprec">
    <div class="container">
      <span class="eyebrow">Case em destaque</span>
      <h2 id="case-comprec" class="case-title">
        {caso.empresa} — {caso.tema}
      </h2>

      <div class="case-grid">
        <!-- Coluna visual: arte da vendedora + selo -->
        <figure class="seller">
          <img
            src={`/img/${caso.arteVendedora}-1086.webp`}
            srcset={`/img/${caso.arteVendedora}-560.webp 560w, /img/${caso.arteVendedora}-1086.webp 1086w`}
            sizes="(max-width: 860px) 92vw, 440px"
            width="1086" height="1448"
            alt={`${caso.vendedora}, vendedora da Fourlink responsável pelo atendimento à ${caso.empresa}`}
            loading="lazy" decoding="async"
          />
          <figcaption class="seller-cap">
            <span class="m">★</span> {caso.vendedora} · {caso.vendedoraTag}
          </figcaption>
        </figure>

        <!-- Coluna texto: narrativa + resultado + depoimento -->
        <div class="case-body">
          <p class="case-lead">{caso.resumo}</p>

          <div class="result">
            <span class="result-k mono">Resultado</span>
            <strong>{caso.resultado}</strong>
          </div>

          {caso.depoimento && (
            <blockquote class="quote">
              <p>&ldquo;{caso.depoimento}&rdquo;</p>
              {caso.depoimentoAutor && <cite>{caso.depoimentoAutor}</cite>}
            </blockquote>
          )}

          <div class="seller-line">
            <span class="sign-name">{caso.vendedora}</span>
            <span class="sign-role mono">Vendas B2B · Fourlink Empresas</span>
          </div>

          <a
            href={caso.instagram}
            class="ig-btn"
            target="_blank"
            rel="noopener"
            aria-label={`Ver a ${caso.empresa} no Instagram`}
          >
            <svg class="ig-ic" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16m0-2.16C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.13 1.38C1.35 2.68.93 3.35.63 4.14.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.13.67.66 1.34 1.08 2.13 1.38.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.86 5.86 0 0 0 2.13-1.38 5.86 5.86 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.86 5.86 0 0 0-1.38-2.13A5.86 5.86 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0Zm0 5.84A6.16 6.16 0 1 0 18.16 12 6.16 6.16 0 0 0 12 5.84Zm0 10.16A4 4 0 1 1 16 12a4 4 0 0 1-4 4Zm6.4-10.4a1.44 1.44 0 1 1-1.44-1.44 1.44 1.44 0 0 1 1.44 1.44Z" />
            </svg>
            <span>Ver a {caso.empresa} no Instagram</span>
          </a>
          <span class="ig-handle mono">{caso.instagramHandle}</span>
        </div>
      </div>

      <!-- Foto real da equipe do cliente -->
      <figure class="team-shot">
        <img
          src={`/img/${caso.fotoEquipe}-1440.webp`}
          srcset={`/img/${caso.fotoEquipe}-880.webp 880w, /img/${caso.fotoEquipe}-1440.webp 1440w`}
          sizes="(max-width: 1160px) 92vw, 1100px"
          width="1440" height="1080"
          alt={caso.fotoEquipeAlt}
          loading="lazy" decoding="async"
        />
        <figcaption><span class="dot"></span> {caso.empresa} · momento real da comemoração</figcaption>
      </figure>

      <!-- Vídeo dos bastidores -->
      <div class="video-wrap">
        <div class="video-head">
          <span class="eyebrow">Bastidores</span>
          <p>Um pedacinho da energia da equipe da {caso.empresa}.</p>
        </div>
        <video
          class="case-video"
          controls
          playsinline
          preload="metadata"
          poster={`/video/${caso.video}-poster.webp`}
        >
          <source src={`/video/${caso.video}.mp4`} type="video/mp4" />
          Seu navegador não suporta a exibição deste vídeo.
        </video>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Sua empresa pode ser o próximo case"
    text="Peça uma análise gratuita da sua fatura e descubra o potencial de economia da sua operação."
  />
</BaseLayout>

<style>
  /* --- Hero --- */
  .cases-hero {
    background: var(--grad-soft);
    color: #fff;
    padding-block: clamp(3rem, 8vw, 5.5rem);
    position: relative;
    overflow: hidden;
  }
  .cases-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(60% 50% at 12% 8%, rgba(184, 122, 79, 0.22), transparent 70%),
      radial-gradient(50% 60% at 100% 100%, rgba(200, 49, 26, 0.18), transparent 70%);
  }
  .cases-hero .container { position: relative; }
  .eyebrow.on-dark { color: var(--pink-soft); }
  .cases-hero h1 { color: #fff; font-size: var(--step-3); margin: 1rem 0 1rem; max-width: 20ch; }
  .cases-hero p { color: #c6d1ea; max-width: 62ch; font-size: var(--step-1); line-height: 1.55; }

  /* --- Case --- */
  .case-title { font-size: var(--step-2); color: var(--navy); margin: 0.6rem 0 2rem; max-width: 26ch; }
  .case-grid {
    display: grid;
    grid-template-columns: minmax(0, 440px) 1fr;
    gap: clamp(1.6rem, 4vw, 3rem);
    align-items: start;
  }

  /* Coluna visual — arte da vendedora */
  .seller {
    margin: 0;
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(216, 168, 120, 0.4);
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.55);
    background: var(--ink);
  }
  .seller img { width: 100%; height: auto; display: block; }
  .seller-cap {
    position: absolute;
    left: 0.85rem;
    top: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: #fff;
    background: rgba(14, 27, 60, 0.72);
    backdrop-filter: blur(8px);
    border: 1px solid var(--copper);
    border-radius: 999px;
    padding: 0.4rem 0.8rem;
  }
  .seller-cap .m { color: var(--copper-soft); }

  /* Coluna texto */
  .case-body { padding-top: 0.4rem; }
  .case-lead { color: #2c3650; font-size: 1.05rem; line-height: 1.7; margin-bottom: 1.5rem; }
  .result {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    background: var(--mist);
    border: 1px solid var(--line);
    border-left: 4px solid var(--pink);
    border-radius: var(--radius);
    padding: 1.1rem 1.3rem;
    margin-bottom: 1.6rem;
  }
  .result-k { font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--pink); }
  .result strong { color: var(--navy); font-family: var(--font-display); font-size: 1.12rem; line-height: 1.4; }

  .quote {
    margin: 0 0 1.6rem;
    padding: 1.2rem 1.4rem;
    background: linear-gradient(165deg, rgba(27, 47, 94, 0.05), rgba(27, 47, 94, 0.02));
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .quote p { font-size: 1.08rem; line-height: 1.6; color: var(--ink); font-style: italic; }
  .quote cite {
    display: block;
    margin-top: 0.8rem;
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }

  .seller-line { margin: 0.4rem 0 1.4rem; }
  .sign-name { display: block; font-family: 'Dancing Script', cursive; font-size: 2rem; line-height: 1; color: var(--navy); }
  .sign-role { display: block; font-size: 0.7rem; color: var(--muted); margin-top: 0.25rem; }

  /* Botão Instagram */
  .ig-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.96rem;
    color: #fff;
    padding: 0.85rem 1.3rem;
    border-radius: 999px;
    text-decoration: none;
    background: linear-gradient(70deg, #f58529, #dd2a7b 45%, #8134af 75%, #515bd4);
    box-shadow: 0 10px 26px -10px rgba(221, 42, 123, 0.6);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .ig-btn:hover { transform: translateY(-2px); box-shadow: 0 14px 30px -10px rgba(221, 42, 123, 0.7); }
  .ig-ic { width: 20px; height: 20px; flex-shrink: 0; }
  .ig-handle { display: block; margin-top: 0.7rem; font-size: 0.78rem; color: var(--muted); }

  /* Foto da equipe */
  .team-shot {
    margin: clamp(2.4rem, 6vw, 3.6rem) 0 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-md);
  }
  .team-shot img { width: 100%; height: auto; display: block; }
  .team-shot figcaption {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    padding: 0.9rem 1.1rem;
    background: var(--mist);
  }
  .dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: #3ddc84; flex-shrink: 0;
  }

  /* Vídeo */
  .video-wrap {
    margin-top: clamp(2.4rem, 6vw, 3.6rem);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(1.2rem, 4vw, 2.5rem);
    align-items: center;
  }
  .video-head p { color: var(--muted); font-size: 1.05rem; max-width: 34ch; margin-top: 0.5rem; }
  .case-video {
    width: 100%;
    max-width: 320px;
    aspect-ratio: 464 / 832;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--ink);
    border: 1px solid var(--line);
    box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.5);
    display: block;
  }

  @media (max-width: 860px) {
    .case-grid { grid-template-columns: 1fr; }
    .seller { max-width: 440px; }
    .video-wrap { grid-template-columns: 1fr; }
    .case-video { max-width: 300px; margin-inline: auto; }
  }
</style>
