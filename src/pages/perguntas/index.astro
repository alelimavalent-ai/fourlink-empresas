---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { whatsappUrl } from '@/config/site';

const perguntas = (await getCollection('perguntas')).sort((a, b) => a.data.order - b.data.order);
const path = '/perguntas';
const breadcrumbs = [
  { name: 'Início', href: '/' },
  { name: 'Perguntas', href: path },
];
const wa = whatsappUrl('Tenho uma dúvida sobre telefonia ou internet empresarial.');

// agrupa por categoria
const categorias = [...new Set(perguntas.map((p) => p.data.categoria))];
---

<BaseLayout
  title="Perguntas frequentes sobre telefonia e internet empresarial | Fourlink"
  description="Respostas diretas às principais dúvidas de empresas sobre chip corporativo, portabilidade, internet fibra, redução de custos e planos corporativos. Fourlink Empresas — RJ, MG e ES."
  path={path}
  breadcrumbs={breadcrumbs}
>
  <header class="perg-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Início</a><span>/</span><b>Perguntas</b>
      </nav>
      <span class="eyebrow dk">Perguntas & respostas</span>
      <h1>Respostas diretas para as dúvidas da sua empresa</h1>
      <p class="intro">
        As perguntas que todo gestor faz sobre telefonia e internet corporativa — respondidas
        de forma direta e sem enrolação. Não achou a sua? A Alessandra responde na hora.
      </p>
      <a href={wa} class="btn btn-primary" target="_blank" rel="noopener">Falar com a Alessandra</a>
    </div>
  </header>

  <section class="perg-list-sec">
    <div class="container">
      {categorias.map((cat) => (
        <div class="cat-block">
          <h2 class="cat-title">{cat}</h2>
          <ul class="perg-grid">
            {perguntas.filter((p) => p.data.categoria === cat).map((p) => (
              <li>
                <a href={`/perguntas/${p.data.customSlug}`}>
                  <strong>{p.data.pergunta}</strong>
                  <span class="pg-resp">{p.data.respostaCurta}</span>
                  <span class="pg-go">Ver resposta →</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .perg-hero { background: var(--grad-soft); color: #fff; padding-block: clamp(2.6rem, 7vw, 4.5rem); }
  .crumbs { font-size: 0.8rem; color: #9fb0d2; display: flex; gap: 0.45rem; align-items: center; margin-bottom: 1.4rem; }
  .crumbs a:hover { color: #fff; } .crumbs b { color: #fff; font-weight: 500; }
  .eyebrow.dk { color: var(--copper-soft); }
  .perg-hero h1 { color: #fff; font-size: var(--step-3); margin: 0.7rem 0 1rem; max-width: 20ch; }
  .intro { color: #c6d1ea; max-width: 62ch; font-size: var(--step-1); line-height: 1.55; margin-bottom: 1.6rem; }

  .perg-list-sec { padding-block: clamp(3rem, 7vw, 5rem); }
  .cat-block + .cat-block { margin-top: 2.6rem; }
  .cat-title { font-size: var(--step-1); color: var(--navy); margin-bottom: 1.1rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--line); }
  .perg-grid { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }
  .perg-grid a { display: flex; flex-direction: column; gap: 0.5rem; height: 100%; padding: 1.4rem; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s; }
  .perg-grid a:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: #d6deef; }
  .perg-grid strong { color: var(--navy); font-family: var(--font-display); font-size: 1.05rem; line-height: 1.3; }
  .pg-resp { color: var(--muted); font-size: 0.9rem; line-height: 1.5; flex: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .pg-go { color: var(--red); font-weight: 600; font-size: 0.82rem; }
</style>
