---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { whatsappUrl } from '@/config/site';
---

<BaseLayout title="Página não encontrada | Fourlink Empresas" description="A página que você procura não foi encontrada." noindex={true}>
  <section class="nf">
    <div class="container">
      <span class="code mono">404</span>
      <h1>Essa linha caiu.</h1>
      <p>A página que você procura não existe ou foi movida. Vamos te reconectar.</p>
      <div class="nf-cta">
        <a href="/" class="btn btn-primary">Voltar ao início</a>
        <a href={whatsappUrl()} class="btn btn-ghost" target="_blank" rel="noopener">Falar com a Alessandra</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(4rem, 12vw, 8rem);
    text-align: center;
  }
  .code {
    font-size: clamp(3rem, 12vw, 6rem);
    font-weight: 500;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    line-height: 1;
  }
  .nf h1 { font-size: var(--step-3); margin: 1rem 0 0.6rem; }
  .nf p { color: var(--muted); max-width: 44ch; margin: 0 auto 2rem; }
  .nf-cta { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; }
</style>
