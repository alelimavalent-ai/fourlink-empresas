---
import { whatsappUrl, ECONOMY_STATEMENT } from '@/config/site';
interface Props {
  heading?: string;
  text?: string;
  variant?: 'full' | 'compact';
}
const {
  heading = 'Descubra quanto a sua empresa pode economizar',
  text = ECONOMY_STATEMENT,
  variant = 'full',
} = Astro.props;
---

<section class:list={['cta-band', variant]}>
  <div class="container cta-inner">
    {
      variant === 'full' && (
        <figure class="cta-photo">
          <img
            src="/img/alessandra-real-480.webp"
            srcset="/img/alessandra-real-480.webp 480w, /img/alessandra-real-800.webp 800w"
            sizes="(max-width: 760px) 220px, 280px"
            width="480"
            height="600"
            alt="Alessandra, do atendimento 24h da Fourlink Empresas"
            loading="lazy"
            decoding="async"
          />
          <figcaption><span class="dot" /> Alessandra · atendimento 24h</figcaption>
        </figure>
      )
    }
    <div class="cta-body">
      <span class="eyebrow on-dark">Fale com a Fourlink</span>
      <h2>{heading}</h2>
      <p>{text}</p>
      <div class="cta-actions">
        <a href="/calculadora-de-economia" class="btn btn-primary">Calcular minha economia</a>
        <a href={whatsappUrl()} class="btn btn-on-dark" target="_blank" rel="noopener">
          Falar agora no WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--grad-soft);
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  .cta-band::after {
    content: '';
    position: absolute;
    right: -120px;
    top: -120px;
    width: 360px;
    height: 360px;
    background: radial-gradient(circle, rgba(200, 49, 26, 0.4), transparent 70%);
    pointer-events: none;
  }
  .cta-inner {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4rem);
    padding-block: clamp(2.6rem, 6vw, 4.5rem);
    position: relative;
    z-index: 1;
  }
  .cta-photo {
    margin: 0;
    flex-shrink: 0;
  }
  .cta-photo img {
    width: clamp(180px, 26vw, 280px);
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }
  .cta-photo figcaption {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: #cdd7ee;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3ddc84;
    box-shadow: 0 0 0 0 rgba(61, 220, 132, 0.6);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(61, 220, 132, 0.5);
    }
    70% {
      box-shadow: 0 0 0 9px rgba(61, 220, 132, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(61, 220, 132, 0);
    }
  }
  .eyebrow.on-dark {
    color: var(--pink-soft);
  }
  .cta-body h2 {
    color: #fff;
    font-size: var(--step-3);
    margin: 0.6rem 0 0.8rem;
    max-width: 18ch;
  }
  .cta-body p {
    color: #c7d2ea;
    max-width: 52ch;
    margin-bottom: 1.6rem;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  @media (max-width: 720px) {
    .cta-inner {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }
    .cta-body h2,
    .cta-body p {
      max-width: 100%;
    }
    .cta-actions {
      justify-content: center;
    }
  }
</style>
