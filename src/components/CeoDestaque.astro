---
import { FOUNDER, CODIRECTOR, whatsappUrl } from '@/config/site';
const wa = whatsappUrl('Gostaria de falar com um especialista da Fourlink Empresas.');
const ceoWa = `https://wa.me/${FOUNDER.whatsappDigits}?text=${encodeURIComponent(FOUNDER.directMessage)}`;
---

<section class="ceo">
  <div class="container">
    <span class="eyebrow dk">Liderança</span>
    <h2>À frente da Fourlink, lado a lado</h2>
    <p class="ceo-sub">Dois sócios conduzem a Fourlink Empresas todos os dias — da estratégia comercial à estrutura do atendimento.</p>

    <div class="leaders-duo">
      <figure class="lead-photo">
        <img
          src={`/img/${FOUNDER.img}-880.webp`}
          srcset={`/img/${FOUNDER.img}-480.webp 480w, /img/${FOUNDER.img}-880.webp 880w`}
          sizes="(max-width: 760px) 90vw, 360px"
          width="704" height="880"
          alt={`${FOUNDER.name}, ${FOUNDER.role} da Fourlink Empresas`}
          loading="lazy" decoding="async"
        />
        <figcaption class="seal"><span class="m">★</span> CEO Fundador</figcaption>
        <div class="lead-name">
          <strong>Alessandro Valentim</strong>
          <span>CEO · Especialista Corporativo em Telecomunicações</span>
        </div>
      </figure>

      <figure class="lead-photo">
        <img
          src={`/img/${CODIRECTOR.img}-880.webp`}
          srcset={`/img/${CODIRECTOR.img}-480.webp 480w, /img/${CODIRECTOR.img}-880.webp 880w`}
          sizes="(max-width: 760px) 90vw, 360px"
          width="704" height="880"
          alt={`${CODIRECTOR.name}, ${CODIRECTOR.role} da Fourlink Empresas`}
          loading="lazy" decoding="async"
        />
        <figcaption class="seal seal-2"><span class="m">◆</span> Diretora</figcaption>
        <div class="lead-name">
          <strong>Lene Silva</strong>
          <span>Diretora · Cofundadora</span>
        </div>
      </figure>
    </div>

    <div class="ceo-bottom">
      <div class="ceo-text">
        <div class="cstat">
          <strong>28+</strong>
          <span>anos de experiência em telecomunicações corporativas à frente do negócio</span>
        </div>
        <p>
          Alessandro Valentim construiu a Fourlink sobre um princípio simples: analisar antes de prometer.
          Ao lado de Lene Silva, diretora e cofundadora, a empresa une autoridade técnica e atendimento
          próximo para reduzir os custos de telefonia e internet das empresas do Rio de Janeiro, Minas Gerais
          e Espírito Santo.
        </p>
        <div class="sign">
          <span class="nm">Alessandro Valentim</span>
          <span class="rl">CEO · Fourlink Empresas</span>
        </div>
        <div class="cact">
          <a href="/sobre" class="btn btn-ghost">Conheça nossa história</a>
          <a href={wa} class="btn btn-primary" target="_blank" rel="noopener">Falar com um especialista</a>
        </div>
      </div>

      <aside class="ceo-direct">
        <span class="cd-label">Contato direto</span>
        <h3>Fale diretamente com o CEO</h3>
        <p class="cd-text">
          Algumas empresas preferem conversar diretamente com o fundador antes de tomar uma decisão.
          Caso deseje um atendimento mais próximo, você pode falar diretamente comigo.
        </p>
        <div class="cd-id">
          <strong>Alessandro Valentim</strong>
          <span>CEO Fundador · Especialista em Telecom Corporativa</span>
          <span>Mais de 28 anos de experiência</span>
        </div>
        <a href={ceoWa} class="cd-btn" target="_blank" rel="noopener" aria-label="Falar diretamente com o CEO no WhatsApp">
          <svg class="wa-ic" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.334.101 11.892c0 2.096.549 4.142 1.595 5.945L0 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.585 0 11.946-5.336 11.949-11.896 0-3.176-1.24-6.165-3.495-8.411"/></svg>
          <span>Falar diretamente com o CEO</span>
        </a>
        <span class="cd-num mono">WhatsApp direto: {FOUNDER.whatsappDisplay}</span>
      </aside>
    </div>
  </div>
</section>

<style>
  .ceo { background: var(--grad-soft); color: #fff; padding-block: clamp(3.4rem, 8vw, 6rem); position: relative; overflow: hidden; }
  .ceo::before { content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(60% 50% at 12% 8%, rgba(184,122,79,.22), transparent 70%), radial-gradient(50% 60% at 100% 100%, rgba(47,111,224,.16), transparent 70%); }
  .ceo .container { position: relative; }
  .eyebrow.dk { color: var(--copper-soft); }
  .ceo h2 { color: #fff; font-size: var(--step-2); margin: 0.7rem 0 0.6rem; max-width: 22ch; }
  .ceo-sub { color: #c6d1ea; max-width: 60ch; margin-bottom: 2.2rem; }

  .leaders-duo { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.2rem, 3vw, 2rem); max-width: 760px; }
  .lead-photo { margin: 0; position: relative; border-radius: var(--radius-lg); overflow: hidden;
    border: 1px solid rgba(216,168,120,.4); box-shadow: 0 30px 70px -28px rgba(0,0,0,.8); }
  .lead-photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; display: block; }
  .seal { position: absolute; left: 0.85rem; top: 0.85rem; display: inline-flex; align-items: center; gap: 0.45rem;
    font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.04em; color: #fff;
    background: rgba(14,27,60,.72); backdrop-filter: blur(8px); border: 1px solid var(--copper);
    border-radius: 999px; padding: 0.4rem 0.8rem; }
  .seal .m { color: var(--copper-soft); }
  .lead-name { position: absolute; left: 0; right: 0; bottom: 0; padding: 1.6rem 1rem 0.9rem;
    background: linear-gradient(transparent, rgba(11,21,48,.82)); }
  .lead-name strong { display: block; font-family: var(--font-display); font-size: 1.05rem; color: #fff; }
  .lead-name span { display: block; font-family: var(--font-mono); font-size: 0.64rem; color: var(--copper-soft); margin-top: 0.15rem; }

  .ceo-bottom { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(1.6rem, 4vw, 3rem); margin-top: clamp(2.2rem, 5vw, 3.2rem); align-items: stretch; max-width: 980px; }
  .ceo-text { max-width: 620px; }
  .cstat { display: flex; align-items: center; gap: 0.9rem; padding: 0.9rem 0 1.4rem;
    border-top: 1px solid rgba(255,255,255,.14); border-bottom: 1px solid rgba(255,255,255,.14); margin-bottom: 1.4rem; }
  .cstat strong { font-family: var(--font-display); font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3.2rem); line-height: 1;
    background: linear-gradient(120deg, var(--copper-soft), #fff); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .cstat span { color: #c6d1ea; font-size: 0.95rem; max-width: 30ch; }
  .ceo-text > p { color: #d3dcef; font-size: 1.02rem; line-height: 1.65; max-width: 64ch; margin-bottom: 1.2rem; }
  .sign { margin: 1.2rem 0 1.6rem; }
  .sign .nm { display: block; font-family: 'Dancing Script', cursive; font-size: 2rem; line-height: 1; color: #fff; }
  .sign .rl { display: block; font-family: var(--font-mono); font-size: 0.7rem; color: var(--muted-light); margin-top: 0.3rem; }
  .cact { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .btn-ghost { background: transparent; color: #fff; border: 1px solid rgba(255,255,255,.3); }
  .btn-ghost:hover { border-color: #fff; background: rgba(255,255,255,.06); }

  /* Card premium — contato direto com o CEO */
  .ceo-direct {
    position: relative;
    display: flex;
    flex-direction: column;
    background: linear-gradient(165deg, rgba(255,255,255,.07), rgba(255,255,255,.02));
    border: 1px solid rgba(216,168,120,.45);
    border-radius: var(--radius-lg);
    padding: 1.7rem;
    box-shadow: 0 30px 70px -34px rgba(0,0,0,.85);
    overflow: hidden;
  }
  .ceo-direct::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, var(--copper), var(--copper-soft), var(--copper)); }
  .cd-label { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--copper-soft); }
  .ceo-direct h3 { color: #fff; font-family: var(--font-display); font-size: 1.3rem; margin: 0.5rem 0 0.7rem; }
  .cd-text { color: #c6d1ea; font-size: 0.94rem; line-height: 1.6; margin-bottom: 1.2rem; }
  .cd-id { padding: 0.9rem 0 1.2rem; border-top: 1px solid rgba(255,255,255,.12); }
  .cd-id strong { display: block; font-family: var(--font-display); color: #fff; font-size: 1.02rem; }
  .cd-id span { display: block; font-family: var(--font-mono); font-size: 0.7rem; color: var(--copper-soft); margin-top: 0.2rem; }
  .cd-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem;
    background: #25d366; color: #fff; font-family: var(--font-display); font-weight: 600;
    font-size: 0.96rem; padding: 0.85rem 1.3rem; border-radius: 999px; text-decoration: none;
    box-shadow: 0 10px 26px -8px rgba(37,211,102,.5);
    animation: cd-pulse 2.8s ease-in-out infinite;
    transition: transform 0.18s ease, background 0.18s ease;
  }
  .cd-btn:hover { background: #1fbe5b; transform: translateY(-2px); }
  .cd-btn .wa-ic { width: 21px; height: 21px; flex-shrink: 0; }
  .cd-num { margin-top: 0.85rem; font-size: 0.78rem; color: #aeb9d4; text-align: center; }
  @keyframes cd-pulse {
    0%, 100% { box-shadow: 0 10px 26px -8px rgba(37,211,102,.5), 0 0 0 0 rgba(37,211,102,.45); }
    50% { box-shadow: 0 10px 26px -8px rgba(37,211,102,.5), 0 0 0 12px rgba(37,211,102,0); }
  }
  @media (prefers-reduced-motion: reduce) { .cd-btn { animation: none; } }

  @media (max-width: 820px) {
    .ceo-bottom { grid-template-columns: 1fr; }
    .ceo-direct { max-width: 480px; }
  }
  @media (max-width: 560px) {
    .leaders-duo { grid-template-columns: 1fr; max-width: 420px; }
  }
</style>
