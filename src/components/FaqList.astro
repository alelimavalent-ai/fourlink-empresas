---
import { whatsappUrl } from '@/config/site';
interface Props {
  faqs: { q: string; a: string }[];
  title?: string;
}
const { faqs, title = 'Perguntas frequentes' } = Astro.props;
const wa = whatsappUrl('Vi as perguntas frequentes no site e ainda tenho uma dúvida.');
---

{
  faqs.length > 0 && (
    <section class="faq">
      <div class="container">
        <span class="eyebrow">FAQ</span>
        <h2>{title}</h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="faq-item">
              <summary>
                <span>{f.q}</span>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
              </summary>
              <div class="faq-a">
                <p>{f.a}</p>
                <p class="faq-cta">Ainda ficou alguma dúvida? <a href={wa} target="_blank" rel="noopener">Fale agora com a Alessandra</a>.</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .faq {
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  .faq h2 {
    font-size: var(--step-3);
    margin: 0.6rem 0 2rem;
  }
  .faq-list {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .faq-item {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    transition: border-color 0.18s, box-shadow 0.18s;
  }
  .faq-item[open] {
    border-color: #d6deef;
    box-shadow: var(--shadow-sm);
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.3rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.04rem;
    color: var(--navy);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary svg {
    flex-shrink: 0;
    color: var(--pink);
    transition: transform 0.22s ease;
  }
  .faq-item[open] summary svg {
    transform: rotate(180deg);
  }
  .faq-a {
    padding: 0 1.3rem 1.2rem;
    color: var(--muted);
  }
  .faq-cta {
    margin-top: 0.8rem;
    padding-top: 0.8rem;
    border-top: 1px dashed var(--line);
    font-size: 0.9rem;
    color: var(--muted);
  }
  .faq-cta a {
    color: var(--red);
    font-weight: 600;
    text-decoration: none;
  }
  .faq-cta a:hover { text-decoration: underline; }
</style>
